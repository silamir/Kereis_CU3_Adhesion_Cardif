# Normalisation des fins de ligne : evite que chaque poste produise des diffs
# de CRLF sur des fichiers qu'il n'a pas modifies.
* text=auto eol=lf

*.sh   text eol=lf
*.java text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.md   text eol=lf
*.html text eol=lf

Dockerfile text eol=lf
